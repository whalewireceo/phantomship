# --- Data source -------------------------------------------------------------
# 'simulator' (default) runs entirely offline with planted anomalies.
# 'live' subscribes to the AISStream.io global feed (see README, Running against live AIS).
PHANTOMSHIP_DATA_SOURCE=simulator

# Simulator tuning
PHANTOMSHIP_SIM_VESSELS=180
PHANTOMSHIP_SIM_ANOMALY_RATE=0.08
PHANTOMSHIP_SIM_TICK=2.0

# --- Live AIS feed (free key at https://aisstream.io) ------------------------
AISSTREAM_API_KEY=

# --- AI analyst (Claude) -----------------------------------------------------
# Optional. When unset, a deterministic rule-based assessment is used so the
# UI behaves identically — no provisioning required to demo the project.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Cap on Claude calls per minute
PHANTOMSHIP_AI_MAX_CALLS_PER_MINUTE=10

# --- Housekeeping ------------------------------------------------------------
# Live vessels silent this long leave the active picture / are dropped
PHANTOMSHIP_LIVE_STALE_MINUTES=30
PHANTOMSHIP_LIVE_EVICT_HOURS=6
# Findings log rotates at this size (MB)
PHANTOMSHIP_FINDINGS_MAX_MB=100
